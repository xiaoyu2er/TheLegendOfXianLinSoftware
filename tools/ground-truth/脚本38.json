  "dialogue": [[["1","院庆主持:","看来私人恩怨已经解决了啊~!"],["1","院庆主持:","既然软件堂的选手已经来了~我们校庆的比武大会现在就开始吧~偶哈哈"],["1","院庆主持:","这位选手,请你按照【从右至左】的顺序,依次挑战【物理阁大弟子】,【物理阁护法】,和【物理阁堂主】.全部战胜的话,就算软件堂取胜~~"],["0","7","怎么我们要打这么多..."],["0","43","是啊!不公平吧!"],["1","院庆主持:","这是长老们订的规矩,我只能从命啊!"],["1","院庆主持:","谁说不公平啦!你们一次就三个人一起上场呢!"],["1","院庆主持:","对你们有优势呢~!要不要开始啊!直接认输吗?!"],["0","0","我们才不怕呢!"],["0","40","嗯嗯呃."],["1","院庆主持:","那就请开始吧~~~~"]],[["0","7","物理阁的大弟子吗?..@"],["1","物理阁大弟子:","早就听说软件堂的武术套路奇特,今日可以切磋切磋了,放马过来吧!"]],[["1","物理阁护法:","我是我大物理阁的头号护法,软件堂的小子们!"],["0","7","那么,不客气了..@"],["1","物理阁护法:","接招吧!"]],[["1","物理阁堂主:","接连打败了我的得意门徒和头号护法,实力不一般呀."],["0","7","这是物理阁堂主大人啊...@"],["1","物理阁堂主:","小辈们接老朽几招吧!"]]],
